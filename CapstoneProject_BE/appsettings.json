{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "EPPlus": {
    "License": {
      "LicenseContext": "NonCommercial"
    }
  },

  "AI": {
    "Enabled": false,
    "DefaultProvider": "OpenAI",
    "FallbackProvider": null,

    "Providers": {
      "OpenAI": {
        "ApiKey": "",
        "Model": "gpt-4o",
        "TimeoutSeconds": 60,
        "MaxRetries": 2
      },
      "AzureOpenAI": {
        "ApiKey": "",
        "BaseUrl": "",
        "DeploymentName": "",
        "ApiVersion": "2024-05-01-preview",
        "TimeoutSeconds": 60,
        "MaxRetries": 2
      },
      "Anthropic": {
        "ApiKey": "",
        "Model": "claude-3-5-sonnet-20241022",
        "TimeoutSeconds": 60,
        "MaxRetries": 2
      },
      "GoogleGemini": {
        "ApiKey": "",
        "Model": "gemini-2.5-pro",
        "TimeoutSeconds": 60,
        "MaxRetries": 2
      }
    },

    "Cache": {
      "Enabled": true,
      "DefaultTtlSeconds": 3600
    },

    "RateLimit": {
      "RequestsPerMinutePerUser": 20,
      "RequestsPerMinuteGlobal": 200
    }
  }
}